---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact MyToolMint" description="Contact MyToolMint with feedback, word-list corrections or questions."><section class="container page"><p class="eyebrow">Contact</p><h1 class="display-title">Help us make the tools better.</h1><p class="lead">Report a bug, suggest an improvement or flag a word-list problem through the public MyToolMint GitHub repository.</p><div class="notice"><strong>GitHub issues are public.</strong><p>Do not include passwords, private contact details or other sensitive information. You will need a GitHub account to submit an issue.</p></div><a class="button button-primary" href="https://github.com/cthedj/mytoolmint/issues/new">Open a GitHub issue ↗</a></section></BaseLayout>
<style>.page{padding-block:clamp(4rem,10vw,8rem);min-height:60vh}.notice{max-width:42rem;margin-top:2rem;padding:1rem 1.15rem;border:1px solid var(--border);border-radius:var(--radius);background:#fff}.notice p{margin:.25rem 0 0;color:var(--muted)}.button{margin-top:1.25rem}</style>
