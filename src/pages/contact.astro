---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact MyToolMint" description="Contact MyToolMint with feedback, corrections or questions."><section class="container page"><p class="eyebrow">Contact</p><h1 class="display-title">Help us make the tools better.</h1><p class="lead">A public contact method will be added before launch. Until then, project feedback can be submitted through the MyToolMint GitHub repository.</p><a class="button button-primary" href="https://github.com/cthedj/mytoolmint/issues">Open a GitHub issue ↗</a></section></BaseLayout>
<style>.page{padding-block:clamp(4rem,10vw,8rem);min-height:60vh}.button{margin-top:2rem}</style>
