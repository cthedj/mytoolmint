---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pagePath } from '../lib/site-path';
const base = Astro.site?.hostname === 'cthedj.github.io' ? '/mytoolmint/' : '/';
const tools = [
  ['Five-Letter Word Finder', 'Filter five-letter words by known positions and included or excluded letters.', '/five-letter-word-finder', '5'],
  ['Wordle Solver', 'Use correct, misplaced and excluded letters to narrow possible answers.', '/wordle-solver', '✓'],
  ['Word Counter', 'Count words, characters, sentences and estimated reading time as you write.', '/word-counter', '#'],
  ['Word Unscrambler', 'Make every word you can from a letter rack, blanks and filters.', '/word-unscrambler', 'Aa'],
  ['Word Finder', 'Search rack letters with blanks and a known position pattern.', '/word-finder', '?'],
  ['Anagram Solver', 'Rearrange every supplied letter into exact anagrams.', '/anagram-solver', '⇄'],
  ['Word List & Scoring', 'See the word-list source, coverage and generic tile-score method.', '/word-list-and-scoring', 'i'],
];
---
<BaseLayout title="Word Tools — Find, Solve and Count Words | MyToolMint" description="Explore free word tools for finding five-letter words, solving Wordle-style clues, unscrambling letters, anagrams and word counts." canonicalPath="/word-tools">
  <header class="container page-head"><p class="eyebrow">Word tools</p><h1 class="display-title">Find the word.<br/>Finish the thought.</h1><p class="lead">Practical browser-based tools for word games, puzzles and writing. Choose the search that fits the clue you have.</p></header>
  <main class="container"><section class="cards" aria-label="Word tools">{tools.map(([name, description, path, icon]) => <a class="card" href={pagePath(path, base)}><span class="icon" aria-hidden="true">{icon}</span><div><h2>{name}</h2><p>{description}</p></div><b aria-hidden="true">↗</b></a>)}</section>
  <section class="guide"><div><p class="eyebrow">Pick a starting point</p><h2>Match the tool to your clue</h2></div><div><p>Have Wordle-style feedback? Start with the <a href={pagePath('/wordle-solver', base)}>Wordle Solver</a>. Know a five-letter pattern or some letters to avoid? Use the <a href={pagePath('/five-letter-word-finder', base)}>Five-Letter Word Finder</a>.</p><p>Have a rack of letters? Try <a href={pagePath('/word-unscrambler', base)}>Word Unscrambler</a> for flexible filters, <a href={pagePath('/word-finder', base)}>Word Finder</a> for a position pattern, or <a href={pagePath('/anagram-solver', base)}>Anagram Solver</a> when every letter must be used.</p></div></section></main>
</BaseLayout>
<style>.page-head{padding-block:clamp(4rem,9vw,7rem)}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem}.card{display:grid;grid-template-columns:3rem 1fr auto;align-items:start;gap:1rem;min-height:10rem;padding:1.2rem;border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;text-decoration:none;transition:border-color .15s ease,transform .15s ease,box-shadow .15s ease}.card:hover{border-color:#8bdcc3;box-shadow:0 15px 35px rgb(8 26 34/.08);transform:translateY(-3px)}.icon{display:grid;width:3rem;aspect-ratio:1;place-items:center;border-radius:.8rem;background:var(--mint-soft);color:var(--mint-dark);font-weight:900}.card h2{margin:.2rem 0 .35rem;font-size:1.08rem;line-height:1.2}.card p,.guide p{margin:0;color:var(--muted);font-size:.9rem}.card b{color:var(--mint-dark)}.guide{display:grid;grid-template-columns:1fr 1.25fr;gap:clamp(2rem,6vw,6rem);margin:clamp(4rem,9vw,7rem) 0;padding:clamp(1.5rem,5vw,3rem);border-radius:var(--radius-lg);background:var(--mint-soft)}.guide h2{margin:.35rem 0 0;font-size:clamp(1.8rem,4vw,3rem);letter-spacing:-.04em}.guide p+p{margin-top:1rem}.guide a{font-weight:800}@media(max-width:52rem){.cards{grid-template-columns:1fr 1fr}}@media(max-width:40rem){.cards,.guide{grid-template-columns:1fr}.card{min-height:auto}}</style>
