---
const base = Astro.site?.hostname === 'cthedj.github.io' ? '/mytoolmint/' : '/';
const destination = `${base}word-unscrambler`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Open the free MyToolMint Word Unscrambler." />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href="https://mytoolmint.com/word-unscrambler" />
    <title>Opening Word Unscrambler — MyToolMint</title>
    <script is:inline define:vars={{ destination }}>window.location.replace(destination);</script>
  </head>
  <body>
    <main>
      <h1>Opening the Word Unscrambler…</h1>
      <p>If you are not redirected, <a href={destination}>open the free Word Unscrambler</a>.</p>
    </main>
  </body>
</html>
<style>body{display:grid;min-height:100vh;margin:0;place-items:center;padding:1rem;background:#fbfaf6;color:#081a22;font-family:Inter,ui-sans-serif,system-ui,sans-serif;text-align:center}h1{margin:0;font-size:clamp(1.75rem,5vw,3rem)}p{color:#536b74}a{color:#0b755d;font-weight:750}</style>
