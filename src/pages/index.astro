---
import BaseLayout from '../layouts/BaseLayout.astro';
import WordUnscrambler from '../components/WordUnscrambler.astro';
import { toolCategories, tools } from '../lib/tools';
const base=Astro.site?.hostname==='cthedj.github.io'?'/mytoolmint/':'/';
const url=(value:string)=>`${base}${value.replace(/^\//,'')}`;
const schema=[
  {'@context':'https://schema.org','@type':'WebSite',name:'MyToolMint',url:'https://mytoolmint.com/',description:'Simple, fast online tools for everyday problems.'},
  {'@context':'https://schema.org','@type':'Organization',name:'MyToolMint',url:'https://mytoolmint.com/',logo:'https://mytoolmint.com/favicon.svg'},
];
---
<BaseLayout title="MyToolMint — Simple tools for everyday problems" description="Fast, free word tools, calculators and converters built to solve everyday problems without sign-ups or clutter." canonicalPath="/" schema={schema}>
  <section class="hero container">
    <div class="hero-copy"><p class="eyebrow">The useful side of the internet</p><h1>Small tools.<br/><span>Big time-savers.</span></h1><p class="lead">Free word tools, calculators and converters that get to the answer quickly—no account, no app and no clutter.</p><div class="actions"><a class="button button-primary" href={url('/tools')}>Explore all 14 tools <span aria-hidden="true">→</span></a><a class="button button-secondary" href="#word-unscrambler">Start with letters</a></div><p class="hero-note"><span aria-hidden="true">●</span> All tools run directly in your browser.</p></div>
    <div class="hero-tool" id="word-unscrambler"><WordUnscrambler headingLevel="h2" /></div>
  </section>

  <section class="catalog container" aria-labelledby="catalog-title">
    <div class="section-head"><div><p class="eyebrow">One tidy toolbox</p><h2 id="catalog-title">Fourteen tools, ready to use.</h2></div><a href={url('/tools')}>View the full directory →</a></div>
    <div class="category-grid">{toolCategories.map((category)=>{
      const categoryTools=tools.filter((tool)=>tool.category===category);
      return <article class="category"><p class="category-count">{categoryTools.length} tools</p><h3>{category}</h3><ul>{categoryTools.map((tool)=><li><a href={url(`/${tool.path}`)}><span class="tool-icon" aria-hidden="true">{tool.icon}</span><span><strong>{tool.name}</strong><small>{tool.description}</small></span><b aria-hidden="true">→</b></a></li>)}</ul></article>;
    })}</div>
  </section>

  <section class="promise"><div class="container promise-inner"><div><p class="eyebrow">Built with restraint</p><h2>Useful by design.</h2></div><div class="principles"><article><span>01</span><h3>Fast</h3><p>Lightweight pages and browser-based calculations keep answers close to instant.</p></article><article><span>02</span><h3>Private</h3><p>No accounts, application database, analytics or advertising in this launch version.</p></article><article><span>03</span><h3>Clear</h3><p>Readable interfaces, transparent assumptions and content that explains the answer.</p></article></div></div></section>
</BaseLayout>
<style>
.hero{display:grid;grid-template-columns:minmax(18rem,.68fr) minmax(32rem,1.32fr);align-items:center;gap:clamp(2rem,5vw,5rem);min-height:calc(100vh - 5.5rem);padding-block:clamp(3rem,7vw,6rem)}.hero h1{max-width:10ch;margin:0;font-size:clamp(3.5rem,7vw,6.2rem);line-height:.86;letter-spacing:-.075em}.hero h1 span{color:var(--mint-dark)}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.hero-note{display:flex;align-items:center;gap:.5rem;margin:1.25rem 0 0;color:var(--muted);font-size:.82rem;font-weight:700}.hero-note span{color:var(--mint)}.hero-tool{scroll-margin-top:1rem;min-width:0}.catalog{padding-block:clamp(5rem,10vw,9rem)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:2rem}.section-head h2,.promise h2{max-width:12ch;margin:0;font-size:clamp(2.4rem,6vw,4.5rem);line-height:1;letter-spacing:-.055em}.section-head>a{color:var(--mint-dark);font-weight:800}.category-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.category{padding:1.25rem;border:1px solid var(--border);border-radius:var(--radius-lg);background:rgb(255 255 255/.7)}.category-count{margin:0;color:var(--mint-dark);font-size:.72rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.category h3{margin:.2rem 0 1rem;font-size:1.5rem;letter-spacing:-.03em}.category ul{display:grid;gap:.35rem;margin:0;padding:0;list-style:none}.category a{display:grid;grid-template-columns:2.4rem 1fr auto;align-items:center;gap:.75rem;padding:.7rem;border-radius:.8rem;text-decoration:none}.category a:hover{background:var(--mint-soft)}.tool-icon{display:grid;width:2.4rem;aspect-ratio:1;place-items:center;border:1px solid var(--border);border-radius:.65rem;background:#fff;color:var(--mint-dark);font-size:.8rem;font-weight:900}.category strong,.category small{display:block}.category strong{line-height:1.25}.category small{margin-top:.15rem;color:var(--muted);font-size:.76rem;line-height:1.35}.category a>b{color:var(--mint-dark)}.promise{padding-block:clamp(5rem,10vw,9rem);background:var(--navy);color:#fff}.promise .eyebrow{color:#7ae8c5}.promise-inner{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(2rem,8vw,8rem)}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.principles article{padding-top:1rem;border-top:1px solid rgb(255 255 255/.2)}.principles span{color:#7ae8c5;font-size:.72rem;font-weight:900}.principles h3{margin:1.25rem 0 .25rem;font-size:1.3rem}.principles p{margin:0;color:#bad0d6;font-size:.9rem}@media(max-width:62rem){.hero{grid-template-columns:1fr;min-height:auto}.hero-copy{max-width:44rem}.hero-tool{max-width:58rem}.category-grid{grid-template-columns:1fr 1fr}.category:last-child{grid-column:1/-1}.promise-inner{grid-template-columns:1fr}}@media(max-width:38rem){.hero{padding-top:3.5rem}.hero h1{font-size:clamp(3.25rem,16vw,5.2rem)}.category-grid,.principles{grid-template-columns:1fr}.category:last-child{grid-column:auto}.section-head{align-items:flex-start;flex-direction:column}}
</style>
