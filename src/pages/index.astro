---
import BaseLayout from '../layouts/BaseLayout.astro';
const categories=[['Aa','Word tools','Find, shape and understand words.','Available now'],['%','Calculators','Quick answers without spreadsheet setup.','Planned'],['↔','Converters','Everyday measurements made effortless.','Planned'],['¶','Text tools','Clean, count and transform text.','Planned']];
const base=Astro.site?.hostname==='cthedj.github.io'?'/mytoolmint/':'/';
---
<BaseLayout title="MyToolMint — Simple tools for everyday problems" description="Fast, friendly online tools for words, calculations, conversions and everyday tasks.">
  <section class="hero container" aria-labelledby="page-title">
    <div><p class="eyebrow">Useful by design</p><h1 class="display-title" id="page-title">Small tools. Big time-savers.</h1><p class="lead">MyToolMint gives you straightforward, thoughtfully built tools that solve the little problems slowing down your day.</p><div class="actions"><a class="button button-primary" href="#first-tool">Meet our first tool ↓</a><a class="button button-secondary" href={`${base}about`}>Why MyToolMint?</a></div><ul><li>✓ Free to use</li><li>✓ Fast on mobile</li><li>✓ No sign-up</li></ul></div>
    <div class="art" aria-hidden="true"><div class="orbit"></div><div class="tool one"><span>Letters</span><strong>T R A E S</strong><small>→ 53 words found</small></div><div class="tool two"><span>Quick answer</span><strong>Instant.</strong><small>No waiting around</small></div><i class="spark">✦</i></div>
  </section>
  <section class="first" id="first-tool" aria-labelledby="first-title"><div class="container feature"><div><p class="eyebrow">Available now</p><h2 id="first-title">A seriously useful Word Unscrambler.</h2><p>Built for speed and clarity—with smart filters, duplicate-letter accuracy, useful sorting and a great mobile experience.</p></div><a class="launch" href={`${base}word-unscrambler`}><strong>Unscramble your letters</strong><span>Open the free tool →</span></a></div></section>
  <section class="categories container" aria-labelledby="category-title"><div class="heading"><div><p class="eyebrow">Built to grow</p><h2 id="category-title">One dependable toolbox.</h2></div><p>Every tool will earn its place by being genuinely useful.</p></div><div class="cards">{categories.map(([icon,name,description,status])=><article><span class="icon">{icon}</span><h3>{name}</h3><p>{description}</p><small>{status}</small></article>)}</div></section>
</BaseLayout>
<style>
.hero{display:grid;min-height:min(45rem,calc(100vh - 5.5rem));grid-template-columns:1.05fr .95fr;align-items:center;gap:clamp(2rem,7vw,6rem);padding-block:clamp(3rem,7vw,6rem)}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}ul{display:flex;flex-wrap:wrap;gap:.75rem 1.25rem;margin:1.75rem 0 0;padding:0;color:var(--muted);font-size:.9rem;font-weight:700;list-style:none}.art{position:relative;min-height:30rem}.orbit{position:absolute;inset:8% 5% 8% 12%;border:1px solid #72dfbd;border-radius:44% 56% 46% 54%;background:linear-gradient(145deg,var(--mint-soft),rgb(255 255 255/.4));transform:rotate(-8deg)}.tool{position:absolute;display:flex;width:min(18rem,72%);flex-direction:column;padding:1.5rem;border:1px solid rgb(255 255 255/.8);border-radius:var(--radius-lg);background:rgb(255 255 255/.84);box-shadow:var(--shadow);backdrop-filter:blur(12px)}.one{top:15%;left:0;transform:rotate(-4deg)}.two{right:0;bottom:16%;transform:rotate(5deg)}.tool span,.tool small{color:var(--muted);font-size:.78rem;font-weight:700}.tool strong{margin:.55rem 0;font-size:1.55rem;letter-spacing:.08em}.two strong{letter-spacing:-.04em}.spark{position:absolute;top:6%;right:15%;color:var(--mint-dark);font-size:2rem}.first{padding:clamp(3rem,6vw,5rem) 0;background:var(--navy);color:#fff}.feature{display:grid;grid-template-columns:1.25fr .75fr;align-items:center;gap:3rem}.first .eyebrow{color:#72dfbd}h2{margin:0;font-size:clamp(2rem,5vw,3.5rem);line-height:1.05;letter-spacing:-.045em}.first p:not(.eyebrow){max-width:42rem;color:#bcd0d7;font-size:1.05rem}.launch{display:block;padding:1.25rem;border:1px solid rgb(114 223 189/.3);border-radius:var(--radius);background:rgb(255 255 255/.06);color:#fff;text-decoration:none}.launch strong,.launch span{display:block}.launch span{margin-top:.25rem;color:#72dfbd}.categories{padding-block:clamp(4rem,8vw,7rem)}.heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:2rem}.heading>p{max-width:25rem;color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.cards article{display:flex;min-height:18rem;flex-direction:column;padding:1.35rem;border:1px solid var(--border);border-radius:var(--radius-lg);background:rgb(255 255 255/.7)}.icon{display:grid;width:3rem;aspect-ratio:1;place-items:center;border-radius:.85rem;background:var(--mint-soft);color:var(--mint-dark);font-weight:850}h3{margin:2.5rem 0 .35rem;font-size:1.25rem}.cards p{margin:0;color:var(--muted)}.cards small{margin-top:auto;padding-top:1.25rem;color:var(--mint-dark);font-weight:800;text-transform:uppercase;letter-spacing:.06em}@media(max-width:54rem){.hero{grid-template-columns:1fr}.art{min-height:24rem}.feature{grid-template-columns:1fr}.cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:38rem){.art{min-height:20rem}.tool{width:76%;padding:1.15rem}.heading{display:block}.cards{grid-template-columns:1fr}.cards article{min-height:14rem}}
</style>
