---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/LegalPage.astro';
import { pagePath } from '../lib/site-path';
const base=Astro.site?.hostname==='cthedj.github.io'?'/mytoolmint/':'/';
---
<BaseLayout title="Terms of Use — MyToolMint" description="Terms that apply when using MyToolMint and its free online utilities.">
  <LegalPage eyebrow="Terms" title="Terms of Use" intro="These terms set practical ground rules for using MyToolMint and its free utilities.">
    <section><h2>Acceptance</h2><p>By using MyToolMint, you agree to these terms. If you do not agree, please do not use the website.</p></section>
    <section><h2>The service</h2><p>MyToolMint provides free, general-purpose browser tools and supporting information. Tools, datasets, features and availability may change as the website develops.</p></section>
    <section><h2>Permitted use</h2><p>You may use the website for lawful personal, educational or business purposes. You must not interfere with the website, attempt to bypass security controls, overload its hosting, distribute malware, or use automated access in a way that disrupts service for others.</p></section>
    <section><h2>Results and your responsibility</h2><p>Tool output is provided for convenience and may contain errors or differ from a third party's rules or data. You are responsible for checking results before relying on them. Word tools are not official word-game adjudicators, and calculator projections are not professional advice.</p></section>
    <section><h2>Intellectual property and third-party material</h2><p>MyToolMint's branding, interface and original content may not be misrepresented as your own. The English word data includes licensed third-party material; its notices are described on the <a href={pagePath('/word-list-and-scoring',base)}>word list and scoring page</a> and in the project's public third-party notices.</p></section>
    <section><h2>No warranties</h2><p>To the extent permitted by applicable law, MyToolMint is provided “as is” and “as available”, without warranties that it will always be available, error-free or suitable for a particular purpose.</p></section>
    <section><h2>Limitation of liability</h2><p>To the extent permitted by applicable law, MyToolMint and its operator will not be liable for indirect, incidental or consequential loss arising from use of, or inability to use, the website. Nothing in these terms excludes rights or liability that cannot lawfully be excluded.</p></section>
    <section><h2>Changes and contact</h2><p>These terms may be updated as the service changes. The current version and date will remain on this page. Questions can be submitted through the <a href={pagePath('/contact',base)}>contact page</a>.</p></section>
  </LegalPage>
</BaseLayout>
