---
import BaseLayout from '../layouts/BaseLayout.astro';
import { toolCategories, tools } from '../lib/tools';
import { pagePath } from '../lib/site-path';
const base=Astro.site?.hostname==='cthedj.github.io'?'/mytoolmint/':'/';
const url=(value:string)=>pagePath(value,base);
---
<BaseLayout title="All Tools — MyToolMint" description="Browse all free MyToolMint word tools, calculators and unit converters.">
  <header class="container page-head"><p class="eyebrow">The toolbox</p><h1 class="display-title">Every tool.<br/>Ready when you are.</h1><p class="lead">{tools.length} focused utilities for words, everyday maths and unit conversions. Every card below opens a working tool.</p></header>
  <div class="container directory">{toolCategories.map((category)=>{
    const entries=tools.filter((tool)=>tool.category===category);
    return <section aria-labelledby={category.toLowerCase().replace(' ','-')}><div class="category-head"><h2 id={category.toLowerCase().replace(' ','-')}>{category}</h2><span>{entries.length} tools</span></div><div class="cards">{entries.map((tool)=><a class="card" href={url(`/${tool.path}`)}><span class="icon" aria-hidden="true">{tool.icon}</span><div><h3>{tool.name}</h3><p>{tool.description}</p></div><b aria-hidden="true">↗</b></a>)}</div></section>;
  })}</div>
</BaseLayout>
<style>.page-head{padding-block:clamp(4rem,9vw,7rem)}.directory{display:grid;gap:clamp(4rem,8vw,7rem);padding-bottom:3rem}.category-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:1.25rem;padding-bottom:1rem;border-bottom:1px solid var(--border)}.category-head h2{margin:0;font-size:clamp(2rem,5vw,3.5rem);letter-spacing:-.05em}.category-head span{color:var(--muted);font-size:.82rem;font-weight:800;text-transform:uppercase}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem}.card{display:grid;grid-template-columns:3rem 1fr auto;align-items:start;gap:1rem;min-height:10rem;padding:1.2rem;border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;text-decoration:none;transition:border-color .15s ease,transform .15s ease,box-shadow .15s ease}.card:hover{border-color:#8bdcc3;box-shadow:0 15px 35px rgb(8 26 34/.08);transform:translateY(-3px)}.icon{display:grid;width:3rem;aspect-ratio:1;place-items:center;border-radius:.8rem;background:var(--mint-soft);color:var(--mint-dark);font-weight:900}.card h3{margin:.2rem 0 .35rem;font-size:1.08rem;line-height:1.2}.card p{margin:0;color:var(--muted);font-size:.86rem}.card>b{color:var(--mint-dark)}@media(max-width:52rem){.cards{grid-template-columns:1fr 1fr}}@media(max-width:36rem){.cards{grid-template-columns:1fr}.card{min-height:auto}}
</style>
