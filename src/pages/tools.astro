---
import BaseLayout from '../layouts/BaseLayout.astro';
const base=Astro.site?.hostname==='cthedj.github.io'?'/mytoolmint/':'/';
---
<BaseLayout title="Tools — MyToolMint" description="Explore MyToolMint's growing collection of fast, free everyday tools."><section class="container page"><p class="eyebrow">The toolbox</p><h1 class="display-title">Useful tools, carefully made.</h1><p class="lead">The Word Unscrambler is available now. New tools will appear here only when they are ready to use.</p><a class="notice" href={`${base}word-unscrambler`}><div><strong>Word Unscrambler</strong><p>Find words from letters with smart filters and scoring.</p></div><span>Open tool →</span></a></section></BaseLayout>
<style>.page{padding-block:clamp(4rem,10vw,8rem);min-height:60vh}.notice{display:flex;max-width:42rem;align-items:center;justify-content:space-between;gap:1rem;margin-top:3rem;padding:1.25rem;border:1px solid var(--border);border-radius:var(--radius);background:#fff;text-decoration:none}.notice:hover{border-color:var(--mint)}.notice p{margin:.25rem 0 0;color:var(--muted)}.notice span{color:var(--mint-dark);font-weight:750}</style>
