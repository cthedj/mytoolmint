---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Tools — MyToolMint" description="Explore MyToolMint's growing collection of fast, free everyday tools."><section class="container page"><p class="eyebrow">The toolbox</p><h1 class="display-title">Useful tools, carefully made.</h1><p class="lead">The Word Unscrambler is the first tool in production. New tools will appear here only when they are ready to use.</p><div class="notice"><strong>Word Unscrambler</strong><span>Currently being built</span></div></section></BaseLayout>
<style>.page{padding-block:clamp(4rem,10vw,8rem);min-height:60vh}.notice{display:flex;max-width:35rem;justify-content:space-between;gap:1rem;margin-top:3rem;padding:1.25rem;border:1px solid var(--border);border-radius:var(--radius);background:#fff}.notice span{color:var(--mint-dark);font-weight:750}</style>
