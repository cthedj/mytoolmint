<section class="panel" data-savings><div class="fields"><label>Starting amount<input data-initial type="number" min="0" step="any" value="10000" inputmode="decimal" /></label><label>Monthly contribution<input data-monthly type="number" min="0" step="any" value="1000" inputmode="decimal" /></label><label>Annual interest (%)<input data-rate type="number" min="-99" step="any" value="7" inputmode="decimal" /></label><label>Years<input data-years type="number" min="0" max="100" step=".5" value="10" inputmode="decimal" /></label></div><div class="answer" aria-live="polite"><div><span>Projected balance</span><strong data-balance></strong></div><div><span>Your contributions</span><strong data-contributions></strong></div><div><span>Estimated interest</span><strong data-interest></strong></div></div><p>Assumes monthly compounding and contributions made at the end of each month. Figures are estimates, not financial advice.</p></section>
<script>import{savingsProjection,round}from'../lib/calculators';const root=document.querySelector<HTMLElement>('[data-savings]');if(root){const get=(name:string)=>root.querySelector<HTMLInputElement>(`[data-${name}]`)!.valueAsNumber||0;const update=()=>{const value=savingsProjection(get('initial'),get('monthly'),get('rate'),get('years'));for(const [name,amount] of [['balance',value.finalBalance],['contributions',value.contributions],['interest',value.interest]] as const)root.querySelector<HTMLElement>(`[data-${name}]`)!.textContent=round(amount).toLocaleString('en-ZA',{minimumFractionDigits:2,maximumFractionDigits:2});};root.querySelectorAll('input').forEach(el=>el.addEventListener('input',update));update();}</script>
<style>.panel{padding:clamp(1.25rem,4vw,2rem);border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow)}.fields,.answer{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem}label{display:flex;flex-direction:column;gap:.35rem;color:var(--navy-2);font-size:.84rem;font-weight:800}input{min-height:2.8rem;padding:.6rem;border:1px solid #b7cac4;border-radius:.65rem;font:inherit}.answer{grid-template-columns:repeat(3,1fr);margin-top:1.5rem;padding:1.25rem;border-radius:var(--radius);background:var(--navy);color:#fff}.answer span,.answer strong{display:block}.answer span{color:#bcd0d7;font-size:.8rem}.answer strong{font-size:1.3rem}.panel>p{color:var(--muted);font-size:.8rem}@media(max-width:44rem){.fields{grid-template-columns:repeat(2,1fr)}}@media(max-width:32rem){.answer{grid-template-columns:1fr}}</style>
