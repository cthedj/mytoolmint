---
import Brand from './Brand.astro';
import { toolCategories, tools } from '../lib/tools';
import { pagePath } from '../lib/site-path';
const base=Astro.site?.hostname==='cthedj.github.io'?'/mytoolmint/':'/';
const url=(value:string)=>pagePath(value,base);
const path=pagePath(Astro.url.pathname);
---
<header>
  <div class="container inner">
    <a class="brand-link" href={url('/')} aria-label="MyToolMint home"><Brand /></a>
    <nav aria-label="Primary navigation">
      <a class="about-link" href={url('/about')} aria-current={path===url('/about')?'page':undefined}>About</a>
      <details class="tool-menu" data-tool-menu>
        <summary>Tools <span aria-hidden="true">⌄</span></summary>
        <div class="menu-panel">
          <div class="menu-head"><div><small>MyToolMint</small><strong>Choose a tool</strong></div><a href={url('/tools')}>View all →</a></div>
          <div class="menu-groups">
            {toolCategories.map((category)=><section><h2>{category}</h2><ul>{tools.filter((tool)=>tool.category===category).map((tool)=><li><a href={url(`/${tool.path}`)} aria-current={path===url(`/${tool.path}`)?'page':undefined}><span aria-hidden="true">{tool.icon}</span>{tool.name}</a></li>)}</ul></section>)}
          </div>
        </div>
      </details>
    </nav>
  </div>
</header>
<script>
  const menu=document.querySelector<HTMLDetailsElement>('[data-tool-menu]');
  if(menu){document.addEventListener('click',(event)=>{if(menu.open&&event.target instanceof Node&&!menu.contains(event.target))menu.open=false;});document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&menu.open){menu.open=false;menu.querySelector('summary')?.focus();}});}
</script>
<style>
header{position:relative;z-index:20;padding:1rem 0}.inner{display:flex;min-height:3.5rem;align-items:center;justify-content:space-between;gap:1rem}.brand-link{text-decoration:none}nav{display:flex;align-items:center;gap:.35rem}.about-link,summary{min-height:2.7rem;padding:.55rem .8rem;border-radius:999px;color:var(--navy-2);font-size:.9rem;font-weight:750;text-decoration:none}.about-link{display:inline-flex;align-items:center}.about-link:hover,.about-link[aria-current=page]{background:var(--mint-soft);color:var(--navy)}.tool-menu{position:relative}.tool-menu summary{display:flex;align-items:center;gap:.45rem;border:1px solid var(--border);background:#fff;cursor:pointer;list-style:none}.tool-menu summary::-webkit-details-marker{display:none}.tool-menu summary span{font-size:1rem;transition:transform .15s ease}.tool-menu[open] summary{border-color:#9bdcc8;background:var(--mint-soft);color:var(--navy)}.tool-menu[open] summary span{transform:rotate(180deg)}.menu-panel{position:absolute;top:calc(100% + .65rem);right:0;width:min(46rem,calc(100vw - 2rem));padding:1.1rem;border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;box-shadow:0 24px 70px rgb(8 26 34/.2)}.menu-head{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;padding:.2rem .25rem 1rem;border-bottom:1px solid var(--border)}.menu-head small,.menu-head strong{display:block}.menu-head small{color:var(--mint-dark);font-size:.68rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.menu-head strong{font-size:1.25rem}.menu-head>a{color:var(--mint-dark);font-size:.82rem;font-weight:800}.menu-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;padding-top:1rem}.menu-groups h2{margin:0 .45rem .45rem;color:var(--muted);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}.menu-groups ul{display:grid;gap:.15rem;margin:0;padding:0;list-style:none}.menu-groups a{display:grid;grid-template-columns:1.8rem 1fr;align-items:center;gap:.5rem;min-height:2.4rem;padding:.35rem .45rem;border-radius:.65rem;color:var(--navy-2);font-size:.78rem;font-weight:750;line-height:1.2;text-decoration:none}.menu-groups a:hover,.menu-groups a[aria-current=page]{background:var(--mint-soft);color:var(--navy)}.menu-groups a span{display:grid;width:1.8rem;aspect-ratio:1;place-items:center;border:1px solid var(--border);border-radius:.5rem;background:var(--cream);color:var(--mint-dark);font-size:.65rem;font-weight:900}@media(max-width:39rem){.about-link{display:none}.menu-panel{position:fixed;top:4.6rem;right:.75rem;left:.75rem;width:auto;max-height:calc(100vh - 5.5rem);overflow:auto}.menu-groups{grid-template-columns:1fr}.menu-groups section+section{padding-top:.75rem;border-top:1px solid var(--border)}.menu-groups a{font-size:.84rem}}
</style>
