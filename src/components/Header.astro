---
import Brand from './Brand.astro';
const path=Astro.url.pathname;
const links=[['/','Home'],['/tools','Tools'],['/about','About']];
---
<header><div class="container inner"><a class="brand-link" href="/" aria-label="MyToolMint home"><Brand /></a><nav aria-label="Primary navigation">{links.map(([href,label])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}<a class="contact" href="/contact">Contact</a></nav></div></header>
<style>header{padding:1rem 0}.inner{display:flex;min-height:3.5rem;align-items:center;justify-content:space-between;gap:1rem}.brand-link{text-decoration:none}nav{display:flex;align-items:center;gap:.25rem}nav a{padding:.6rem .75rem;border-radius:999px;color:var(--navy-2);font-size:.9rem;font-weight:700;text-decoration:none}nav a:hover,nav a[aria-current=page]{background:var(--mint-soft);color:var(--navy)}.contact{border:1px solid var(--border);background:rgb(255 255 255/.65)}@media(max-width:39rem){nav a:not(.contact){display:none}}</style>
