<section class="panel" data-age><div class="row"><label>Date of birth<input data-birth type="date" /></label><label>Age on<input data-on type="date" /></label></div><p class="error" data-error role="alert"></p><div class="answer" hidden data-answer aria-live="polite"><div><strong data-years>0</strong><span>years</span></div><div><strong data-months>0</strong><span>months</span></div><div><strong data-days>0</strong><span>days</span></div></div><p class="total" data-total></p></section>
<script>import{calculateAge}from'../lib/calculators';const root=document.querySelector<HTMLElement>('[data-age]');if(root){const birth=root.querySelector<HTMLInputElement>('[data-birth]')!,on=root.querySelector<HTMLInputElement>('[data-on]')!,answer=root.querySelector<HTMLElement>('[data-answer]')!,error=root.querySelector<HTMLElement>('[data-error]')!;on.value=new Date().toISOString().slice(0,10);const update=()=>{error.textContent='';if(!birth.value||!on.value){answer.hidden=true;return;}try{const age=calculateAge(new Date(`${birth.value}T00:00:00Z`),new Date(`${on.value}T00:00:00Z`));root.querySelector<HTMLElement>('[data-years]')!.textContent=String(age.years);root.querySelector<HTMLElement>('[data-months]')!.textContent=String(age.months);root.querySelector<HTMLElement>('[data-days]')!.textContent=String(age.days);root.querySelector<HTMLElement>('[data-total]')!.textContent=`That is ${age.totalDays.toLocaleString()} days in total.`;answer.hidden=false;}catch(e){answer.hidden=true;error.textContent=e instanceof Error?e.message:'Check the dates.';}};root.querySelectorAll('input').forEach(el=>el.addEventListener('input',update));}</script>
<style>.panel{padding:clamp(1.25rem,4vw,2rem);border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow)}.row,.answer{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}label{display:flex;flex-direction:column;gap:.4rem;color:var(--navy-2);font-size:.86rem;font-weight:800}input{min-height:3rem;padding:.65rem;border:1px solid #b7cac4;border-radius:.7rem;font:inherit}.answer{grid-template-columns:repeat(3,1fr);margin-top:1.5rem;padding:1.25rem;border-radius:var(--radius);background:var(--navy);color:#fff}.answer strong,.answer span{display:block;text-align:center}.answer strong{font-size:2rem}.answer span{color:#bcd0d7}.error{color:#a32d2d}.total{color:var(--muted);text-align:center}@media(max-width:34rem){.row{grid-template-columns:1fr}}</style>
