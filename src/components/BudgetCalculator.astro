<section class="panel" data-budget><label>Monthly income<input data-income type="number" min="0" step="any" value="30000" inputmode="decimal" /></label><h2>Monthly expenses</h2><div class="expenses">{['Housing','Transport','Food','Debt','Utilities','Insurance','Entertainment','Other'].map((name)=><label>{name}<input data-expense type="number" min="0" step="any" value="0" inputmode="decimal" /></label>)}</div><div class="answer" aria-live="polite"><div><span>Total expenses</span><strong data-expenses></strong></div><div><span>Remaining</span><strong data-remaining></strong></div><div><span>Savings rate</span><strong data-rate></strong></div></div></section>
<script>import{budgetSummary,round}from'../lib/calculators';const root=document.querySelector<HTMLElement>('[data-budget]');if(root){const update=()=>{const income=root.querySelector<HTMLInputElement>('[data-income]')!.valueAsNumber||0,expenses=[...root.querySelectorAll<HTMLInputElement>('[data-expense]')].map(el=>el.valueAsNumber||0),value=budgetSummary(income,expenses);root.querySelector<HTMLElement>('[data-expenses]')!.textContent=round(value.expenses).toLocaleString();root.querySelector<HTMLElement>('[data-remaining]')!.textContent=round(value.remaining).toLocaleString();root.querySelector<HTMLElement>('[data-rate]')!.textContent=`${round(value.savingsRate,1)}%`;root.classList.toggle('over',value.remaining<0);};root.querySelectorAll('input').forEach(el=>el.addEventListener('input',update));update();}</script>
<style>.panel{padding:clamp(1.25rem,4vw,2rem);border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow)}label{display:flex;flex-direction:column;gap:.35rem;color:var(--navy-2);font-size:.84rem;font-weight:800}input{min-height:2.8rem;padding:.6rem;border:1px solid #b7cac4;border-radius:.65rem;font:inherit}.panel>label{max-width:20rem}h2{margin:1.75rem 0 .75rem;font-size:1.1rem}.expenses{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem}.answer{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1.5rem;padding:1.25rem;border-radius:var(--radius);background:var(--navy);color:#fff}.answer span,.answer strong{display:block}.answer span{color:#bcd0d7;font-size:.8rem}.answer strong{font-size:1.4rem}.over .answer{background:#681f27}@media(max-width:44rem){.expenses{grid-template-columns:repeat(2,1fr)}}@media(max-width:32rem){.answer{grid-template-columns:1fr}}</style>
