---
const base=Astro.site?.hostname==='cthedj.github.io'?'/mytoolmint/':'/';
---
<section class="panel" data-finder data-base={base}><div class="fields"><label>Available letters<input data-letters type="text" maxlength="32" autocomplete="off" placeholder="LETTERS??" /><small>Use ? for up to two blank tiles.</small></label><label>Optional pattern<input data-pattern type="text" maxlength="30" autocomplete="off" placeholder="S??RE" /><small>Use ? for an unknown position.</small></label></div><button type="button" data-search>Find words</button><p data-message role="status" aria-live="polite"></p><div class="results" data-results></div></section>
<script>import{canBuildWordWithWildcards,sanitiseLetters,tileScore}from'../lib/word-solver';import{loadWordBuckets}from'../lib/word-data';const root=document.querySelector<HTMLElement>('[data-finder]');if(root){const input=root.querySelector<HTMLInputElement>('[data-letters]')!,patternInput=root.querySelector<HTMLInputElement>('[data-pattern]')!,message=root.querySelector<HTMLElement>('[data-message]')!,results=root.querySelector<HTMLElement>('[data-results]')!;const search=async()=>{const raw=input.value.toLowerCase().replace(/[^a-z?]/g,'').slice(0,30),wildcards=Math.min(2,[...raw].filter(c=>c==='?').length),letters=sanitiseLetters(raw)+ '?'.repeat(wildcards),pattern=patternInput.value.toLowerCase().replace(/[^a-z?]/g,'');results.replaceChildren();if(letters.length<2){message.textContent='Enter at least two letters or blanks.';return;}message.textContent='Checking the word list…';try{const loadLetters=wildcards?'abcdefghijklmnopqrstuvwxyz':letters;const dictionary=await loadWordBuckets(loadLetters,root.dataset.base);const regex=pattern?new RegExp(`^${pattern.replaceAll('?','.')}$`):null;const found=dictionary.filter(word=>word.length<=letters.length&&(!regex||regex.test(word))&&canBuildWordWithWildcards(word,letters)).map(word=>({word,score:tileScore(word)})).sort((a,b)=>b.word.length-a.word.length||b.score-a.score||a.word.localeCompare(b.word));message.textContent=`${found.length} word${found.length===1?'':'s'} found.`;for(const item of found){const button=document.createElement('button');button.type='button';button.innerHTML=`<strong>${item.word}</strong><small>${item.score} pts</small>`;button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(item.word);message.textContent=`Copied ${item.word}.`;}catch{message.textContent='Copy is not available in this browser.';}});results.append(button);}}catch{message.textContent='The word list could not be loaded.';}};root.querySelector('[data-search]')!.addEventListener('click',search);}</script>
<style>.panel{padding:clamp(1.25rem,4vw,2rem);border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow)}.fields{display:grid;grid-template-columns:1fr 1fr;gap:1rem}label{display:flex;flex-direction:column;gap:.35rem;color:var(--navy-2);font-weight:800}input{min-height:3.25rem;padding:.7rem;border:1px solid #b7cac4;border-radius:.7rem;font:inherit;font-weight:800;text-transform:uppercase}small{color:var(--muted);font-weight:500}.panel>button{min-height:3rem;margin-top:1rem;padding:.6rem 1rem;border:0;border-radius:.7rem;background:var(--navy);color:#fff;font-weight:800}.panel>p{color:var(--muted)}.results{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem}.results button{display:flex;justify-content:space-between;gap:.5rem;padding:.7rem;border:1px solid var(--border);border-radius:.65rem;background:#fff}.results small{flex:none}@media(max-width:44rem){.fields{grid-template-columns:1fr}.results{grid-template-columns:repeat(2,1fr)}}</style>
