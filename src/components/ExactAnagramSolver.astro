---
const base=Astro.site?.hostname==='cthedj.github.io'?'/mytoolmint/':'/';
---
<section class="panel" data-anagram data-base={base}><label>Letters to rearrange<input data-letters type="text" maxlength="30" autocomplete="off" spellcheck="false" placeholder="For example: LISTEN" /></label><button class="primary" type="button" data-search>Find anagrams</button><p class="message" data-message role="status" aria-live="polite"></p><div class="results" data-results></div></section>
<script>import{sanitiseLetters,solveWords}from'../lib/word-solver';import{loadWordBuckets}from'../lib/word-data';const root=document.querySelector<HTMLElement>('[data-anagram]');if(root){const input=root.querySelector<HTMLInputElement>('[data-letters]')!,message=root.querySelector<HTMLElement>('[data-message]')!,results=root.querySelector<HTMLElement>('[data-results]')!;const search=async()=>{const letters=sanitiseLetters(input.value);results.replaceChildren();if(letters.length<2){message.textContent='Enter at least two letters.';return;}message.textContent='Checking the word list…';try{const dictionary=await loadWordBuckets(letters,root.dataset.base),solved=solveWords(dictionary,letters,{filters:{exactLength:letters.length},sort:'alphabetical'});message.textContent=`${solved.total} exact anagram${solved.total===1?'':'s'} found.`;for(const item of solved.results){const button=document.createElement('button');button.textContent=item.word;button.type='button';button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(item.word);message.textContent=`Copied ${item.word}.`;}catch{message.textContent='Copy is not available in this browser.';}});results.append(button);}}catch{message.textContent='The word list could not be loaded.';}};root.querySelector('[data-search]')!.addEventListener('click',search);input.addEventListener('keydown',e=>{if(e.key==='Enter')void search();});}</script>
<style>.panel{padding:clamp(1.25rem,4vw,2rem);border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow)}label{display:flex;flex-direction:column;gap:.4rem;color:var(--navy-2);font-weight:800}input{min-height:3.5rem;padding:.75rem 1rem;border:2px solid #b7cac4;border-radius:var(--radius);font:inherit;font-size:1.35rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.primary{min-height:3.2rem;margin-top:.75rem;padding:.7rem 1rem;border:0;border-radius:var(--radius);background:var(--navy);color:#fff;font-weight:800}.message{color:var(--muted)}.results{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem}.results button{padding:.75rem;border:1px solid var(--border);border-radius:.65rem;background:#fff;font-weight:800}.results button:hover{background:var(--mint-soft)}@media(max-width:38rem){.results{grid-template-columns:repeat(2,1fr)}}</style>
