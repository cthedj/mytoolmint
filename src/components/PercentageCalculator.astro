<section class="panel" data-percentage><label>Calculation<select data-mode><option value="of">What is X% of Y?</option><option value="ratio">X is what percentage of Y?</option><option value="change">Percentage change from X to Y</option></select></label><div class="row"><label><span data-first-label>Percentage</span><input data-first type="number" step="any" inputmode="decimal" value="15" /></label><label><span data-second-label>Number</span><input data-second type="number" step="any" inputmode="decimal" value="200" /></label></div><div class="answer" aria-live="polite"><span>Answer</span><strong data-result>30</strong></div></section>
<script>import{percentageChange,percentageOf,percentageRatio,round}from'../lib/calculators';const root=document.querySelector<HTMLElement>('[data-percentage]');if(root){const mode=root.querySelector<HTMLSelectElement>('[data-mode]')!,first=root.querySelector<HTMLInputElement>('[data-first]')!,second=root.querySelector<HTMLInputElement>('[data-second]')!,result=root.querySelector<HTMLElement>('[data-result]')!,labels=root.querySelectorAll<HTMLElement>('[data-first-label],[data-second-label]');const update=()=>{const a=first.valueAsNumber,b=second.valueAsNumber;labels[0].textContent=mode.value==='of'?'Percentage':'First number';labels[1].textContent=mode.value==='of'?'Number':'Second number';if(!Number.isFinite(a)||!Number.isFinite(b)){result.textContent='Enter two numbers';return;}const value=mode.value==='of'?percentageOf(a,b):mode.value==='ratio'?percentageRatio(a,b):percentageChange(a,b);result.textContent=Number.isFinite(value)?`${round(value,4).toLocaleString('en-ZA',{maximumFractionDigits:4})}${mode.value==='of'?'':'%'}`:'Cannot divide by zero';};root.querySelectorAll('input,select').forEach(el=>el.addEventListener('input',update));update();}</script>
<style>.panel{padding:clamp(1.25rem,4vw,2rem);border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow)}label{display:flex;flex-direction:column;gap:.4rem;color:var(--navy-2);font-size:.86rem;font-weight:800}.row{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}input,select{min-height:3rem;padding:.65rem .75rem;border:1px solid #b7cac4;border-radius:.7rem;background:#fff;font:inherit}.answer{margin-top:1.5rem;padding:1.25rem;border-radius:var(--radius);background:var(--navy);color:#fff}.answer span,.answer strong{display:block}.answer span{color:#bcd0d7}.answer strong{font-size:clamp(2rem,7vw,3.5rem)}@media(max-width:34rem){.row{grid-template-columns:1fr}}</style>
