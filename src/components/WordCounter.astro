<section class="panel" data-counter><label for="counter-text">Paste or type your text</label><textarea id="counter-text" data-text rows="12" placeholder="Start typing to count words, characters, sentences and more…"></textarea><div class="stats"><div><strong data-words>0</strong><span>Words</span></div><div><strong data-chars>0</strong><span>Characters</span></div><div><strong data-nospace>0</strong><span>Without spaces</span></div><div><strong data-sentences>0</strong><span>Sentences</span></div><div><strong data-paragraphs>0</strong><span>Paragraphs</span></div><div><strong data-reading>0 min</strong><span>Reading time</span></div></div><div class="keywords"><h2>Most-used words</h2><p data-keywords>No words yet.</p></div></section>
<script>const root=document.querySelector<HTMLElement>('[data-counter]');if(root){const text=root.querySelector<HTMLTextAreaElement>('[data-text]')!,stop=new Set(['the','and','a','an','to','of','in','is','it','that','for','on','with','as','at','by','be','this','or','are','from']);const set=(name:string,value:string|number)=>root.querySelector<HTMLElement>(`[data-${name}]`)!.textContent=String(value);const update=()=>{const value=text.value.trim(),words=value?value.match(/[\p{L}\p{N}]+(?:[-'’][\p{L}\p{N}]+)*/gu)??[]:[],sentences=value?(value.match(/[.!?]+(?:\s|$)/g)?.length||1):0,paragraphs=value?value.split(/\n\s*\n/).filter(Boolean).length:0;set('words',words.length);set('chars',text.value.length);set('nospace',text.value.replace(/\s/g,'').length);set('sentences',sentences);set('paragraphs',paragraphs);set('reading',`${Math.ceil(words.length/200)} min`);const counts=new Map<string,number>();words.map(w=>w.toLowerCase()).filter(w=>w.length>2&&!stop.has(w)).forEach(w=>counts.set(w,(counts.get(w)||0)+1));const top=[...counts].sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0])).slice(0,8);set('keywords',top.length?top.map(([w,n])=>`${w} (${n})`).join(' · '):'No words yet.');};text.addEventListener('input',update);}</script>
<style>.panel{padding:clamp(1.25rem,4vw,2rem);border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow)}label{display:block;margin-bottom:.5rem;color:var(--navy-2);font-weight:800}textarea{width:100%;padding:1rem;border:1px solid #b7cac4;border-radius:var(--radius);font:inherit;resize:vertical}.stats{display:grid;grid-template-columns:repeat(6,1fr);gap:.5rem;margin-top:1rem}.stats div{padding:.8rem;border-radius:.65rem;background:var(--mint-soft)}.stats strong,.stats span{display:block}.stats strong{font-size:1.25rem}.stats span{color:var(--muted);font-size:.72rem}.keywords{margin-top:1.25rem}.keywords h2{margin:0;font-size:1.1rem}.keywords p{color:var(--muted)}@media(max-width:48rem){.stats{grid-template-columns:repeat(3,1fr)}}@media(max-width:30rem){.stats{grid-template-columns:repeat(2,1fr)}}</style>
