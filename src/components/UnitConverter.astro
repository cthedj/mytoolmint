---
interface Props { kind:'length'|'weight'|'temperature'|'data'|'time'; }
const {kind}=Astro.props;
const units={length:[['m','Metres'],['km','Kilometres'],['cm','Centimetres'],['mm','Millimetres'],['mi','Miles'],['yd','Yards'],['ft','Feet'],['in','Inches']],weight:[['kg','Kilograms'],['g','Grams'],['mg','Milligrams'],['lb','Pounds'],['oz','Ounces'],['st','Stone']],temperature:[['C','Celsius'],['F','Fahrenheit'],['K','Kelvin']],data:[['B','Bytes'],['kB','Kilobytes (kB)'],['MB','Megabytes (MB)'],['GB','Gigabytes (GB)'],['TB','Terabytes (TB)'],['KiB','Kibibytes (KiB)'],['MiB','Mebibytes (MiB)'],['GiB','Gibibytes (GiB)'],['TiB','Tebibytes (TiB)']],time:[['s','Seconds'],['min','Minutes'],['h','Hours'],['d','Days'],['wk','Weeks']]}[kind];
---
<section class="panel" data-converter={kind}><div class="fields"><label>Value<input data-value type="number" inputmode="decimal" value="1" step="any" /></label><label>From<select data-from>{units.map(([value,label])=><option value={value}>{label}</option>)}</select></label><button type="button" data-swap aria-label="Swap units">⇄</button><label>To<select data-to>{units.map(([value,label],index)=><option value={value} selected={index===1}>{label}</option>)}</select></label></div><div class="answer" aria-live="polite"><span>Converted value</span><strong data-result>—</strong><button type="button" data-copy>Copy result</button></div></section>
<script>
import { convertTemperature, convertUnit, round } from '../lib/calculators';
document.querySelectorAll<HTMLElement>('[data-converter]').forEach((root)=>{const value=root.querySelector<HTMLInputElement>('[data-value]')!,from=root.querySelector<HTMLSelectElement>('[data-from]')!,to=root.querySelector<HTMLSelectElement>('[data-to]')!,result=root.querySelector<HTMLElement>('[data-result]')!,copy=root.querySelector<HTMLButtonElement>('[data-copy]')!;const update=()=>{const amount=value.valueAsNumber;if(!Number.isFinite(amount)){result.textContent='Enter a value';return;}const kind=root.dataset.converter!;const converted=kind==='temperature'?convertTemperature(amount,from.value as 'C'|'F'|'K',to.value as 'C'|'F'|'K'):convertUnit(kind as 'length'|'weight'|'data'|'time',amount,from.value,to.value);result.textContent=`${round(converted,8).toLocaleString('en-ZA',{maximumFractionDigits:8})} ${to.value}`;};root.querySelectorAll('input,select').forEach(el=>el.addEventListener('input',update));root.querySelector('[data-swap]')!.addEventListener('click',()=>{[from.value,to.value]=[to.value,from.value];update();});copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(result.textContent??'');copy.textContent='Copied';setTimeout(()=>copy.textContent='Copy result',1200);}catch{copy.textContent='Copy unavailable';}});update();});
</script>
<style>.panel{padding:clamp(1.25rem,4vw,2rem);border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow)}.fields{display:grid;grid-template-columns:1.2fr 1fr auto 1fr;align-items:end;gap:.75rem}label{display:flex;flex-direction:column;gap:.4rem;color:var(--navy-2);font-size:.86rem;font-weight:800}input,select{min-width:0;min-height:3rem;padding:.65rem .75rem;border:1px solid #b7cac4;border-radius:.7rem;background:#fff;font:inherit}.fields button{width:3rem;height:3rem;border:1px solid var(--border);border-radius:50%;background:var(--mint-soft);font-size:1.25rem}.answer{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:1.5rem;padding:1.25rem;border-radius:var(--radius);background:var(--navy);color:#fff}.answer span{color:#bcd0d7;font-size:.82rem}.answer strong{font-size:clamp(1.25rem,4vw,2rem)}.answer button{padding:.55rem .75rem;border:1px solid rgb(255 255 255/.25);border-radius:999px;background:transparent;color:#fff}@media(max-width:43rem){.fields{grid-template-columns:1fr 1fr}.fields button{grid-column:1/-1;justify-self:center}.answer{align-items:flex-start;flex-direction:column}}</style>
