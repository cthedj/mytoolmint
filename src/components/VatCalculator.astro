<section class="panel" data-vat><div class="row"><label>Calculation<select data-mode><option value="add">Add VAT</option><option value="remove">Remove VAT</option></select></label><label>Amount<input data-amount type="number" min="0" step="any" value="100" inputmode="decimal" /></label><label>VAT rate (%)<input data-rate type="number" min="0" step="any" value="15" inputmode="decimal" /></label></div><div class="answer" aria-live="polite"><div><span>Net amount</span><strong data-net></strong></div><div><span>VAT amount</span><strong data-tax></strong></div><div><span>Total</span><strong data-gross></strong></div></div></section>
<script>import{addVat,removeVat,round}from'../lib/calculators';const root=document.querySelector<HTMLElement>('[data-vat]');if(root){const update=()=>{const mode=root.querySelector<HTMLSelectElement>('[data-mode]')!.value,amount=root.querySelector<HTMLInputElement>('[data-amount]')!.valueAsNumber,rate=root.querySelector<HTMLInputElement>('[data-rate]')!.valueAsNumber;if(!Number.isFinite(amount)||!Number.isFinite(rate))return;const value=mode==='add'?addVat(amount,rate):removeVat(amount,rate);for(const [key,result] of [['net',value.net],['tax',value.vat],['gross',value.gross]] as const)root.querySelector<HTMLElement>(`[data-${key}]`)!.textContent=round(result).toLocaleString('en-ZA',{minimumFractionDigits:2,maximumFractionDigits:2});};root.querySelectorAll('input,select').forEach(el=>el.addEventListener('input',update));update();}</script>
<style>.panel{padding:clamp(1.25rem,4vw,2rem);border:1px solid var(--border);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow)}.row,.answer{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}label{display:flex;flex-direction:column;gap:.4rem;color:var(--navy-2);font-size:.86rem;font-weight:800}input,select{min-height:3rem;padding:.65rem;border:1px solid #b7cac4;border-radius:.7rem;background:#fff;font:inherit}.answer{margin-top:1.5rem;padding:1.25rem;border-radius:var(--radius);background:var(--navy);color:#fff}.answer span,.answer strong{display:block}.answer span{color:#bcd0d7;font-size:.8rem}.answer strong{font-size:1.35rem}@media(max-width:40rem){.row,.answer{grid-template-columns:1fr}}</style>
